# Python bytecode
__pycache__/
*.py[cod]

# Package build output (plugins are buildable packages; ADR 0006)
build/
*.egg-info/

# Third-party binary; download separately (Selenium Firefox driver)
geckodriver.exe

# Machine-local Claude Code settings
.claude/settings.local.json

# Local virtualenv (python -m venv .venv)
.venv/

# Local secrets and environment config; commit a .env.example template instead
.env
.env.*
!.env.example

# Personal settings (username, vote pages); commit settings.example.json instead
settings.json
